DATABASE_URL=
JWT_SECRET=
QR_SERVER_SECRET=
ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
# Online payments (member billing, gym subscriptions, gym self-signup) are OFF unless this is "1".
# See PAYMENTS.md.
PAYMENTS_ENABLED=
# Payment provider once PAYMENTS_ENABLED=1: xendit (default) or midtrans. See PAYMENTS.md.
PAYMENT_PROVIDER=xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
MIDTRANS_SERVER_KEY=
# 1 only with live Midtrans keys; anything else uses the sandbox.
MIDTRANS_IS_PRODUCTION=
PLATFORM_WHATSAPP_PROVIDER=fonnte
PLATFORM_WHATSAPP_API_KEY=
# Member photos (private) and gym profile photos (public). Left empty outside production, gym-photo
# uploads are faked with a mock URL so the flow can be tried without a Blob store.
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_APP_URL=
# Shown on the terms and privacy pages as the address people write to.
NEXT_PUBLIC_CONTACT_EMAIL=
CRON_SECRET=
# Dev/test only: fake invoices, no provider account needed. Ignored in production.
PAYMENTS_MOCK=
WHATSAPP_MOCK=
APP_DB_ROLE=iron_app
APP_DB_PASSWORD=
APP_DATABASE_URL=
