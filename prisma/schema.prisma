generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Platform layer ─────────────────────────────────────────

model Superadmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  auditLogs AuditLog[]
}

model SaasPlan {
  id                  String   @id @default(uuid())
  name                String
  price               Decimal
  currency            String   @default("IDR")
  billingInterval     String // "monthly" | "annual"
  maxMembers          Int
  maxStaff            Int
  maxWhatsappPerMonth Int
  customBranding      Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  gyms             Gym[]
  platformPayments PlatformPayment[]
  signups          GymSignup[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model Gym {
  id                 String             @id @default(uuid())
  saasPlanId         String
  saasPlan           SaasPlan           @relation(fields: [saasPlanId], references: [id])
  name               String
  slug               String             @unique
  timezone           String             @default("Asia/Jakarta")
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  nextBillingDate    DateTime?
  isLifetime         Boolean            @default(false) // true = never billed by subscription cron (e.g. founding/investor deals)
  settings           Json               @default("{}")
  termsAcceptedAt    DateTime?          // when the owner accepted the terms and privacy policy
  bankName           String? // shown on the public join page for manual bank-transfer requests
  bankAccountNumber  String?
  bankAccountHolder  String?
  description        String? // public profile page (/[slug])
  address            String?
  photoUrls          String[]           @default([]) // Vercel Blob public URLs, display order = array order
  createdAt          DateTime           @default(now())

  staff              StaffUser[]
  members            Member[]
  plans              MembershipPlan[]
  platformPayments   PlatformPayment[]
  whatsappConfig     WhatsappSenderConfig?
  auditLogs          AuditLog[]
  checkins           CheckIn[]
  payments           Payment[]
  notifications      NotificationLog[]
  memberSignups      MemberSignup[]
  classes            GymClass[]
  classSessions      ClassSession[]
  classRegistrations ClassRegistration[]
  classPayments      ClassPayment[]
  guestPasses        GuestPass[]
  dayPassPlans       DayPassPlan[]

  @@index([subscriptionStatus])
}

model PlatformPayment {
  id                String        @id @default(uuid())
  gymId             String
  gym               Gym           @relation(fields: [gymId], references: [id])
  saasPlanId        String
  saasPlan          SaasPlan      @relation(fields: [saasPlanId], references: [id])
  provider          String // "xendit" | "midtrans" | "manual" (setup fees settled outside the app)
  kind              String        @default("SUBSCRIPTION") // "SUBSCRIPTION" | "SETUP" — a setup fee is one-time and never moves nextBillingDate
  externalInvoiceId String?       @unique
  invoiceUrl        String?       // Xendit hosted payment page, so the owner can pay from the billing page
  amount            Decimal
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  paidAt            DateTime?
  // Bank-transfer evidence (provider "manual"): the owner's transfer screenshot (private Vercel Blob), who sent it and when,
  // reviewed by the superadmin. A rejection keeps the invoice open and records why, so the owner can send better proof.
  proofImageUrl     String?
  proofSubmittedAt  DateTime?
  senderName        String?
  transferDate      String?
  rejectionReason   String?

  @@index([gymId])
}

model WhatsappSenderConfig {
  id              String  @id @default(uuid())
  gymId           String  @unique
  gym             Gym     @relation(fields: [gymId], references: [id])
  gatewayProvider String // "fonnte" | "wablas"
  senderNumber    String
  apiKeyEncrypted String // AES-256-GCM encrypted at application layer — never store plain
  isActive        Boolean @default(true)
}

// ─── Tenant layer ───────────────────────────────────────────

enum Role {
  OWNER
  STAFF
}

model StaffUser {
  id           String   @id @default(uuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  name         String
  email        String   @unique
  phone        String? // used for platform WhatsApp notifications (billing reminders)
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true) // deactivated staff can't log in and lose access immediately
  createdAt    DateTime @default(now())

  checkins              CheckIn[]
  recordedPayments      Payment[]
  recordedClassPayments ClassPayment[]
  reviewedGuestPasses   GuestPass[] @relation("GuestPassReviewer")
  scannedGuestPasses    GuestPass[] @relation("GuestPassScanner")

  @@index([gymId])
}

model MembershipPlan {
  id           String   @id @default(uuid())
  gymId        String
  gym          Gym      @relation(fields: [gymId], references: [id])
  name         String
  durationDays Int
  price        Decimal
  currency     String   @default("IDR")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  members  Member[]
  payments Payment[]
  signups  MemberSignup[]

  @@index([gymId])
}

enum MemberStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  FROZEN
  CANCELLED
}

model Member {
  id                  String         @id @default(uuid())
  gymId               String
  gym                 Gym            @relation(fields: [gymId], references: [id])
  planId              String
  plan                MembershipPlan @relation(fields: [planId], references: [id])
  fullName            String
  phoneWhatsapp       String
  phoneWhatsappLookup String // HMAC blind-index of normalized phone — for exact-match lookup once phone is encrypted
  email               String         @unique // login identifier
  passwordHash        String? // nullable until first-time activation is completed
  photoUrl            String? // Vercel Blob URL (private access, signed at render time)
  hideFromGymBoard    Boolean        @default(false) // the member opted out of the "who's in the gym" list other members can see
  qrSecret            String         @default(uuid())
  status              MemberStatus   @default(PENDING_PAYMENT)
  membershipExpiry    DateTime?
  frozenAt            DateTime?      // set while status is FROZEN; unfreezing pushes the expiry out by the frozen time
  termsAcceptedAt     DateTime?
  anonymizedAt        DateTime?      // personal data erased; the row stays so payment history still adds up
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  checkins           CheckIn[]
  payments           Payment[]
  notifications      NotificationLog[]
  magicLinks         MagicLink[]
  classRegistrations ClassRegistration[]

  @@index([gymId, status])
  @@index([membershipExpiry])
  @@index([phoneWhatsappLookup])
}

enum CheckInResult {
  SUCCESS
  DUPLICATE
  EXPIRED
  FROZEN
  INVALID
}

model CheckIn {
  id          String        @id @default(uuid())
  gymId       String
  gym         Gym           @relation(fields: [gymId], references: [id])
  memberId    String
  member      Member        @relation(fields: [memberId], references: [id])
  staffUserId String?
  staffUser   StaffUser?    @relation(fields: [staffUserId], references: [id])
  checkedInAt DateTime      @default(now())
  checkedOutAt DateTime?    // explicit check-out (member or staff); a SUCCESS without one counts as "in the gym" until the occupancy window lapses
  result      CheckInResult
  deviceLabel String?

  @@index([gymId, checkedInAt])
  @@index([memberId, checkedInAt])
}

enum PaymentProvider {
  XENDIT
  MIDTRANS
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

model Payment {
  id                String          @id @default(uuid())
  gymId             String
  gym               Gym             @relation(fields: [gymId], references: [id])
  memberId          String
  member            Member          @relation(fields: [memberId], references: [id])
  planId            String
  plan              MembershipPlan  @relation(fields: [planId], references: [id])
  provider          PaymentProvider
  externalInvoiceId String?         @unique
  invoiceUrl        String?         // hosted payment page, so an unpaid invoice can be resumed
  amount            Decimal
  currency          String          @default("IDR")
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  paidAt            DateTime?
  note              String? // free text for manual payments, e.g. "paid at front desk"
  recordedById      String? // staff member who entered a manual (CASH) payment
  recordedBy        StaffUser?      @relation(fields: [recordedById], references: [id])

  @@index([gymId])
  @@index([memberId])
}

model NotificationLog {
  id       String   @id @default(uuid())
  gymId    String
  gym      Gym      @relation(fields: [gymId], references: [id])
  memberId String? // null for messages to non-members (guest class tickets)
  member   Member?  @relation(fields: [memberId], references: [id])
  type     String
  channel  String   @default("whatsapp")
  status   String
  sentAt   DateTime @default(now())

  @@index([gymId])
}

model MagicLink {
  id        String    @id @default(uuid())
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id])
  tokenHash String    @unique
  purpose   String    @default("activate") // "activate" (set password/photo) | "qr_fallback" (view QR without login)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id           String     @id @default(uuid())
  superadminId String
  superadmin   Superadmin @relation(fields: [superadminId], references: [id])
  gymId        String?
  gym          Gym?       @relation(fields: [gymId], references: [id])
  action       String
  metadata     Json       @default("{}")
  createdAt    DateTime   @default(now())
}

// ─── Platform config ────────────────────────────────────────

/// Hand-made invoices the superadmin issues to gyms (setup, training, packages) and prints or saves as PDF.
/// Platform-level, not tenant data: no gymId, and the restricted app role is never granted it.
model Invoice {
  id          String    @id @default(uuid())
  number      String    @unique // "INV-2026-0001"
  gymName     String    @default("") // the gym being billed, typed freely (not tied to a Gym row)
  billToName  String // the person who pays
  billToInfo  String    @default("") // address / contact lines, shown under the name
  currency    String    @default("IDR")
  items       Json // [{ description, quantity, unitPrice }]
  total       Decimal
  notes       String    @default("")
  status      String    @default("UNPAID") // "UNPAID" | "PAID" | "VOID"
  issueDate   DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}

model AppConfig {
  key       String   @id // e.g. "theme.default", "theme.allowUserOverride"
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Self-serve signup ──────────────────────────────────────
// Holds a would-be gym until its first subscription invoice is paid; the Gym and owner
// StaffUser are only created then. Unpaid rows are ignored after 24h.

enum SignupStatus {
  PENDING
  PENDING_REVIEW // MemberSignup only: manual bank-transfer request awaiting staff approval
  COMPLETED
  REJECTED // MemberSignup only: staff couldn't confirm the transfer
  CONFLICT // paid, but the slug/email was taken in the meantime — needs manual follow-up
}

model GymSignup {
  id                String       @id @default(uuid())
  gymName           String
  slug              String
  ownerName         String
  ownerEmail        String
  ownerPhone        String?
  passwordHash      String
  saasPlanId        String
  saasPlan          SaasPlan     @relation(fields: [saasPlanId], references: [id])
  status            SignupStatus @default(PENDING)
  externalInvoiceId String?      @unique
  invoiceUrl        String?
  gymId             String?
  termsAcceptedAt   DateTime?
  createdAt         DateTime     @default(now())
  completedAt       DateTime?

  @@index([slug])
  @@index([ownerEmail])
}

// ─── Member self-signup ─────────────────────────────────────
// A would-be member who joined through the public /g/[slug]/join page. They transfer their
// membership fee to the gym's own bank account (shown on the page) and submit this request,
// optionally with a proof-of-transfer image; the Member and its PAID Payment are only created
// once gym staff approves it. Unapproved rows expire after 24h.

model MemberSignup {
  id                  String       @id @default(uuid())
  gymId               String
  gym                 Gym          @relation(fields: [gymId], references: [id])
  planId              String
  plan                MembershipPlan @relation(fields: [planId], references: [id])
  fullName            String
  email               String
  phoneWhatsapp       String // AES-256-GCM encrypted, like Member.phoneWhatsapp
  phoneWhatsappLookup String
  passwordHash        String? // null for a RENEWAL: the member already has an account
  kind                String       @default("JOIN") // "JOIN" (new member) | "RENEWAL" (existing member, memberId set from the start)
  amount              Decimal // snapshot of the plan price when the request was made
  status              SignupStatus @default(PENDING_REVIEW)
  proofImageUrl       String? // Vercel Blob URL (private access), a screenshot of the transfer
  externalInvoiceId   String?      @unique
  invoiceUrl          String?
  memberId            String?
  ipHash              String? // keyed hash of the requester's IP, for throttling only
  termsAcceptedAt     DateTime?
  createdAt           DateTime     @default(now())
  completedAt         DateTime?

  @@index([gymId, createdAt])
  @@index([email])
  @@index([ipHash, createdAt])
}

// ─── Classes ────────────────────────────────────────────────
// A gym sets up class types (GymClass) with a price, schedules individual sessions of them
// (ClassSession — one row per occurrence, no recurrence engine), and members register for a
// session (ClassRegistration) and pay for it (ClassPayment). ClassPayment mirrors Payment rather
// than reusing it: Payment.planId is required and tied to memberships, and the membership webhook
// code depends on that shape.

model GymClass {
  id              String   @id @default(uuid())
  gymId           String
  gym             Gym      @relation(fields: [gymId], references: [id])
  name            String
  description     String?
  instructor      String? // free text for v1, no separate Instructor model yet
  price           Decimal
  currency        String   @default("IDR")
  capacity        Int? // null = unlimited
  durationMinutes Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  sessions ClassSession[]

  @@index([gymId])
}

enum ClassSessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

model ClassSession {
  id        String             @id @default(uuid())
  gymId     String
  gym       Gym                @relation(fields: [gymId], references: [id])
  classId   String
  class     GymClass           @relation(fields: [classId], references: [id])
  startsAt  DateTime
  capacity  Int? // overrides GymClass.capacity for this session if set
  status    ClassSessionStatus @default(SCHEDULED)
  createdAt DateTime           @default(now())

  registrations ClassRegistration[]
  guestPasses   GuestPass[]

  @@index([gymId, startsAt])
}

enum ClassRegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

model ClassRegistration {
  id        String                  @id @default(uuid())
  gymId     String
  gym       Gym                     @relation(fields: [gymId], references: [id])
  sessionId String
  session   ClassSession            @relation(fields: [sessionId], references: [id])
  memberId  String
  member    Member                  @relation(fields: [memberId], references: [id])
  status    ClassRegistrationStatus @default(PENDING_PAYMENT)
  attendance     String?   // "ATTENDED" | "NO_SHOW", marked by staff from the roster once the session has started; null = not marked
  attendanceAt   DateTime?
  proofImageUrl    String? // member's bank-transfer screenshot (private blob) for staff to check before "Record payment"
  proofSubmittedAt DateTime?
  reminderSentAt DateTime? // set by the class-reminders cron before the message goes out, so it's sent at most once
  createdAt DateTime                @default(now())

  payment ClassPayment?

  @@unique([sessionId, memberId]) // one registration per member per session
  @@index([gymId])
  @@index([memberId])
}

model ClassPayment {
  id                String            @id @default(uuid())
  gymId             String
  gym               Gym               @relation(fields: [gymId], references: [id])
  registrationId    String            @unique
  registration      ClassRegistration @relation(fields: [registrationId], references: [id])
  provider          PaymentProvider // XENDIT | MIDTRANS | CASH
  externalInvoiceId String?           @unique
  invoiceUrl        String?
  amount            Decimal
  currency          String            @default("IDR")
  status            PaymentStatus     @default(PENDING)
  createdAt         DateTime          @default(now())
  paidAt            DateTime?
  note              String? // free text for manual payments
  recordedById      String? // staff who recorded a manual (CASH) payment
  recordedBy        StaffUser?        @relation(fields: [recordedById], references: [id])

  @@index([gymId])
}

// ─── Guest class tickets ────────────────────────────────────
// A non-member asks for a spot in one class session from the gym's public page. Staff approves
// (or rejects) the request; approval sends the guest a WhatsApp link to a one-time QR ticket. The
// ticket is scanned at the front desk with the normal check-in scanner, which flips the pass to
// ATTENDED — after that the same QR is dead. Guests have no account, so the phone number is the
// only identity (encrypted + blind-indexed like Member's).

enum GuestPassStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ATTENDED
}

// A day pass is the same ticket for a visit to the gym itself instead of one class: a DayPassPlan
// (name + price, never creates a Member) and a GuestPass with dayPassPlanId + visitDate set instead
// of sessionId. Exactly one of sessionId / dayPassPlanId is set on a pass. Valid on visitDate, a
// calendar day in the gym's timezone.
model DayPassPlan {
  id          String   @id @default(uuid())
  gymId       String
  gym         Gym      @relation(fields: [gymId], references: [id])
  name        String
  price       Decimal
  currency    String   @default("IDR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  guestPasses GuestPass[]

  @@index([gymId])
}

model GuestPass {
  id                  String          @id @default(uuid())
  gymId               String
  gym                 Gym             @relation(fields: [gymId], references: [id])
  sessionId           String?
  session             ClassSession?   @relation(fields: [sessionId], references: [id])
  dayPassPlanId       String?
  dayPassPlan         DayPassPlan?    @relation(fields: [dayPassPlanId], references: [id])
  visitDate           String? // "YYYY-MM-DD" in the gym's timezone; day passes only
  amount              Decimal? // the price when requested (day pass plan or class); counted as revenue when staff approve, i.e. confirm the payment
  proofImageUrl       String? // optional bank-transfer screenshot (private blob), shown to staff before they approve
  proofSubmittedAt    DateTime?
  fullName            String
  phoneWhatsapp       String // encrypted
  phoneWhatsappLookup String // HMAC blind index, one request per phone per session
  ticketSecret        String          @default(uuid()) // signs the ticket QR; rotating it voids the ticket
  status              GuestPassStatus @default(PENDING_REVIEW)
  ipHash              String?
  reviewedById        String?
  reviewedBy          StaffUser?      @relation("GuestPassReviewer", fields: [reviewedById], references: [id])
  reviewedAt          DateTime?
  attendedAt          DateTime?
  scannedById         String?
  scannedBy           StaffUser?      @relation("GuestPassScanner", fields: [scannedById], references: [id])
  createdAt           DateTime        @default(now())

  @@unique([sessionId, phoneWhatsappLookup])
  @@unique([dayPassPlanId, visitDate, phoneWhatsappLookup])
  @@index([gymId, status])
  @@index([ipHash, createdAt])
}

// ─── Password reset / staff invite ──────────────────────────
// One-time links for staff and members to set a new password. Only the SHA-256 of the token is
// stored. "invite" links are used to set the first password of a staff account created by an owner.

model PasswordReset {
  id        String    @id @default(uuid())
  kind      String // "staff" | "member"
  subjectId String
  tokenHash String    @unique
  purpose   String    @default("reset") // "reset" | "invite"
  expiresAt DateTime
  usedAt    DateTime?
  ipHash    String? // keyed hash of the requester's IP, for throttling only
  createdAt DateTime  @default(now())

  @@index([subjectId, createdAt])
  @@index([ipHash, createdAt])
}

/// One row per POST to any login route, success or failure — throttles brute force by IP.
model LoginAttempt {
  id        String   @id @default(uuid())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
